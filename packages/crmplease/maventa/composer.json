{
    "name": "crmplease/maventa",
    "description": "Laravel API service provider for Maventa e-invoicing",
    "type": "library",
    "require": {
        "php": ">=7.0.0",
        "ext-soap": "*",
        "laravel/framework": ">=5.7.0"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "s1doryak",
            "email": "a@sidoryak.ru"
        }
    ],
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Crmplease\\Maventa\\": "src/"
        },
        "files": [
            "packages/crmplease/maventa/src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Crmplease\\Maventa\\Providers\\MaventaServiceProvider"
            ]
